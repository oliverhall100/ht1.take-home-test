{
  "name": "take-home-test",
  "version": "1.0.0",
  "description": "Take home test project",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
