    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "canonicalize": "^2.1.0",
    "dotenv": "^18.0.8",
    "express": "^4.22.1",
    "kysely": "^0.28.18",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^3.25.76"
  }
